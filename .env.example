# ==========================================
# CineGraph - Neo4j & Application Configuration
# ==========================================

# Neo4j Database Connection
# Local Docker instance: bolt://localhost:7687
# Neo4j Aura Cloud: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Application Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
ALLOW_ARBITRARY_CYPHER=true

# Security
SECRET_KEY=cinegraph-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional TMDB Integration for Live Movie Posters
# If omitted or left blank, elegant typographic poster cards will be automatically generated.
TMDB_API_KEY=
